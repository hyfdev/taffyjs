{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "paths": {
      "@taffyjs/node": ["../packages/taffyjs-node/src/index.ts"],
      "@taffyjs/wasm": ["../packages/taffyjs-node/src/index.ts"],
      "@taffyjs/yoga": ["../packages/taffyjs-yoga/src/index.ts"],
      "@taffyjs/yoga-wasm": ["../packages/taffyjs-yoga/src/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
