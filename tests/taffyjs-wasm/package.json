{
  "name": "tests-taffy-wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:browser": "vp build browser --target esnext",
    "check:browser-bundle": "node tests/browser-bundle.ts",
    "check:package": "node tests/package-contents.ts",
    "check:types": "tsc --project tsconfig.public-api.json",
    "test:api": "vp test --run --project api",
    "test:browser": "vp test --run --project browser",
    "test:packed": "node tests/packed-consumer.ts"
  },
  "dependencies": {
    "@taffyjs/node": "workspace:*",
    "@taffyjs/wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
