{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaffyJS Style transport",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "wireVersion", "fields"],
  "properties": {
    "$schema": {
      "const": "./schemas/style-transport.schema.json"
    },
    "formatVersion": {
      "const": 1
    },
    "wireVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "category": {
            "enum": [
              "boolean",
              "number",
              "nullable-number",
              "enum",
              "nullable-enum",
              "partial-point-enum",
              "partial-rect-length-percentage-auto",
              "partial-size-dimension",
              "partial-rect-length-percentage",
              "partial-size-length-percentage",
              "dimension",
              "grid-template-component-array",
              "track-sizing-array",
              "nullable-grid-template-areas",
              "string-matrix",
              "partial-line-grid-placement"
            ]
          },
          "numericFamily": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
