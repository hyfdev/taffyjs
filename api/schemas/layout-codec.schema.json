{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaffyJS layout codec",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "fields"],
  "properties": {
    "$schema": {
      "const": "./schemas/layout-codec.schema.json"
    },
    "formatVersion": {
      "const": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "shape", "documentation"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "shape": {
            "enum": ["number", "point", "size", "rect"]
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            }
          },
          "documentation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
