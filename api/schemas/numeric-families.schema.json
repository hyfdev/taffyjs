{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaffyJS numeric families",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "families"],
  "properties": {
    "$schema": {
      "const": "./schemas/numeric-families.schema.json"
    },
    "formatVersion": {
      "const": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "members"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        }
      }
    }
  }
}
